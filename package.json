{
  "name": "state-demo",
  "version": "0.0.0",
  "private": true,
  "description": "A small Electron kanban board that exercises the state-management patterns from the RFC appendix.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && pnpm arch",
    "smoke": "electron-vite build && SMOKE=1 electron .",
    "arch": "depcruise src --config .dependency-cruiser.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/query-core": "^5.104.1",
    "@tanstack/query-persist-client-core": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "use-sync-external-store": "^1.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.5.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.5.0",
    "electron": "44.4.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.9.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.6"
  }
}
